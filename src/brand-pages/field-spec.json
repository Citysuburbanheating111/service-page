    "financing.eyebrow": { "maxLen": 40 },
    "financing.h2": { "maxLen": 60 },
    "financing.intro": { "maxLen": 140 },
    "financing.options": { "count": 3 },
    "financing.options[].value": { "maxLen": 8 },
    "financing.options[].title": { "maxLen": 32 },
    "financing.options[].body": { "maxLen": 110 },
    "financing.rebates.title": { "maxLen": 30 },
    "financing.rebates.body": { "maxLen": 120 },
    "financing.rebates.cta": { "maxLen": 22 },
    "financing.disclaimer": { "optional": true, "maxLen": 300 },

    "whoYoureCalling.eyebrow": { "maxLen": 30 },
    "whoYoureCalling.h2": { "maxLen": 40 },
    "whoYoureCalling.intro": { "maxLen": 260 },
    "whoYoureCalling.stats": { "count": 4 },
    "whoYoureCalling.stats[].label": { "maxLen": 20 },
    "whoYoureCalling.stats[].value": { "maxLen": 8 },
    "whoYoureCalling.stats[].body": { "maxLen": 100 },
    "whoYoureCalling.whyFamilyHeading": { "maxLen": 50 },
    "whoYoureCalling.whyFamily": { "count": 4 },
    "whoYoureCalling.whyFamily[]": { "maxLen": 80 },

    "reviews.eyebrow": { "maxLen": 40 },
    "reviews.h2": { "maxLen": 45 },
    "reviews.intro": { "maxLen": 160 },
    "reviews.stats": { "count": 4 },
    "reviews.stats[].label": { "maxLen": 65 },
    "reviews.statsSource": { "maxLen": 120 },
    "reviews.reviews": { "min": 4, "max": 8 },
