    "services.groups[].name": { "maxLen": 26 },
    "services.groups[].summary": { "maxLen": 90 },
    "services.groups[].services": { "count": 4 },
    "services.groups[].services[].title": { "maxLen": 42 },
    "services.groups[].services[].description": { "maxLen": 110 },
    "services.groups[].services[].mobileDescription": { "maxLen": 55 },

    "recentJobs.eyebrow": { "maxLen": 50 },
    "recentJobs.h2": { "maxLen": 60 },
    "recentJobs.intro": { "maxLen": 120 },
    "recentJobs.jobs": { "count": 3 },
