    "models.series[].name": { "maxLen": 16 },
    "models.series[].summary": { "maxLen": 100 },
    "models.series[].models": { "min": 1, "max": 6 },
    "models.series[].weDo": { "count": 3 },
    "models.series[].weDo[]": { "maxLen": 85 },
    "models.buildsHeading": { "maxLen": 65 },
    "models.buildsNote": { "maxLen": 50 },
    "models.builds": { "count": 3 },
    "models.builds[].label": { "maxLen": 10 },
