    "pricing.fees[].price": { "maxLen": 8 },
    "pricing.fees[].note": { "maxLen": 100 },
    "pricing.repairs": { "min": 5, "max": 8 },
    "pricing.repairs[].item": { "maxLen": 32 },
    "pricing.repairs[].note": { "maxLen": 60 },
    "pricing.repairs[].range": { "maxLen": 14 },
