    "process.steps[].title": { "maxLen": 30 },
    "process.steps[].body": { "maxLen": 140 },

    "serviceArea.eyebrow": { "maxLen": 60 },
    "serviceArea.h2": { "maxLen": 50 },
    "serviceArea.mapEmbedUrl": { "optional": true, "pattern": "^https://www\\.google\\.com/maps/embed" },
    "serviceArea.mapNote": { "maxLen": 100 },
    "serviceArea.facts": { "count": 5 },
    "serviceArea.facts[].label": { "maxLen": 20 },
    "serviceArea.facts[].value": { "maxLen": 110 },
    "serviceArea.areas": { "count": 4 },
    "serviceArea.areas[].name": { "maxLen": 20 },
    "serviceArea.areas[].neighborhoods": { "maxLen": 80 },
    "serviceArea.areas[].unitsWeSee": { "maxLen": 70 },

    "faq.eyebrow": { "maxLen": 30 },
    "faq.h2": { "maxLen": 45 },
    "faq.items": { "count": 5 },
    "faq.items[].question": { "maxLen": 70 },
    "faq.items[].answer": { "maxLen": 260 },

    "closingCta.eyebrow": { "maxLen": 30 },
    "closingCta.h2": { "maxLen": 50 },
    "closingCta.body": { "maxLen": 160 },
    "closingCta.haveReady": { "count": 6 },
    "closingCta.haveReady[]": { "maxLen": 80 },

    "siblingLinks.otherEquipment": { "count": 4 },
    "siblingLinks.otherEquipment[].label": { "maxLen": 50 },
    "siblingLinks.otherEquipment[].url": { "pattern": "^/brands/[a-z0-9-]+/[a-z0-9-]+-chicago/$" },
    "siblingLinks.otherEquipment[].status": { "oneOf": ["live", "planned"] },
    "siblingLinks.otherBrands": { "count": 4 },
    "siblingLinks.otherBrands[].label": { "maxLen": 50 },
    "siblingLinks.otherBrands[].url": { "pattern": "^/brands/[a-z0-9-]+/[a-z0-9-]+-chicago/$" },
    "siblingLinks.otherBrands[].status": { "oneOf": ["live", "planned"] }
