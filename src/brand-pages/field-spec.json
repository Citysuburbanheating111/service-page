{
  "_about": "Every field the brand page template uses. Path syntax: a.b for objects, a[] for each item of an array. 'count' = exact number of items, 'min'/'max' = item range for arrays, 'maxLen' = max characters for strings, 'optional' = may be empty until publish (QC warns instead of failing). Limits come from the Paper desktop + mobile layouts (C&S American Standard furnace brand page).",
  "fields": {
    "meta.primaryKeyword": { "maxLen": 80 },
    "meta.secondaryKeywords": { "min": 1, "max": 30 },
    "meta.city": { "equals": "Chicago" },
    "meta.brand": { "maxLen": 40 },
    "meta.equipment": { "maxLen": 40 },
    "meta.service": { "maxLen": 40 },
    "meta.slug": { "pattern": "^/brands/[a-z0-9-]+/[a-z0-9-]+-chicago/$" },
    "meta.seoTitle": { "maxLen": 60, "minLen": 30 },
    "meta.metaDescription": { "maxLen": 155, "minLen": 110 },
    "meta.sources": { "min": 1 },
    "meta.priceDate": { "maxLen": 30 },

    "hero.breadcrumb": { "count": 4 },
    "hero.eyebrow": { "maxLen": 70 },
    "hero.h1": { "maxLen": 70 },
    "hero.lede": { "maxLen": 340 },
    "hero.trustChips": { "count": 3 },
    "hero.trustChips[]": { "maxLen": 40 },
    "hero.formTitle": { "maxLen": 50 },
    "hero.formSubtitle": { "maxLen": 120 },
    "hero.modelFieldPlaceholder": { "maxLen": 40 },
    "hero.symptomChips": { "count": 5 },
    "hero.symptomChips[]": { "maxLen": 30 },
    "hero.mobile.h1": { "maxLen": 50 },
    "hero.mobile.lede": { "maxLen": 140 },
    "hero.mobile.valueStrip": { "count": 3 },
    "hero.mobile.valueStrip[].value": { "maxLen": 9 },
