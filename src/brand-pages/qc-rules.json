  "forbidden": [
    {
      "pattern": "\\bfree (estimate|estimates|in-home estimate)\\b",
      "reason": "City & Suburban offers a free quote, not a free estimate"
    },
    {
      "pattern": "\\b(authori[sz]ed|factory[- ]authori[sz]ed|certified|official|premier|elite|pro) (dealer|partner|installer|service (center|provider))\\b",
      "reason": "no dealer or authorized-partner status is confirmed for any brand"
    },
    {
      "pattern": "\\b(Comfort Specialist|Customer Care Dealer|President's Award|Pro Partner|Factory Authorized)\\b",
      "reason": "manufacturer dealer programs are not confirmed"
    },
    {
      "pattern": "\\b(0%|interest[- ]free|no interest|\\d+ (months|years) (of )?financing|low monthly payments? of)\\b",
      "reason": "only 'Wells Fargo Home Projects credit card, subject to credit approval' is confirmed"
    },
    {
      "pattern": "\\bComfort Plan\\b|\\$\\s?(15|179)\\b|plan (costs|is) \\$",
      "reason": "maintenance plan name and price are not published"
    },
    {
      "pattern": "\\b(lifetime|10-year|ten-year) (labor )?(warranty|guarantee)\\b|\\b1-year labor guarantee\\b",
      "reason": "C&S warranty terms are not published; manufacturer warranty terms only from the brand's own site, in sources"
    },
    {
      "pattern": "\\bsame[- ]day (service )?(guaranteed|guarantee)\\b|\\bguaranteed same[- ]day\\b",
      "reason": "same-day only 'when the schedule allows'"
    },
    {
      "pattern": "\\b(773\\)?[ -]?262-3333|ECC9\\d{4}|1,223 (City )?permits|Bozidar|5766 N Lincoln)\\b",
      "reason": "Highlights Chicago facts never appear on a City & Suburban page"
    },
    {
      "pattern": "\\b(Google|Yelp)\\s*(and|\\+|&)\\s*(Yelp|Google)\\s*(rating|average)\\b",
      "reason": "never blend platforms"
    },
    {
      "pattern": "\\b(#1|number one|best (hvac|heating|furnace|ac) (company|contractor) in chicago)\\b",
      "reason": "superlative without proof"
    },
    {
      "pattern": "\\bsince 19(?!52)\\d\\d\\b|\\bfounded in 19(?!52)\\d\\d\\b",
      "reason": "City & Suburban was founded in 1952"
    }
  ],
